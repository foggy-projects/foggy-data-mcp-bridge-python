      "calculatedFields" : [ {
        "name" : "salesAmountPlusTen",
        "expression" : "salesAmountYuan + 10"
      } ]
    },
    "expected" : {
      "javaSqlMarkers" : [ "sales_amount", "/ 100.0", "+ 10" ],
      "pythonSqlMarkers" : [ "((t.sales_amount) / 100.0)", "+ ?" ],
