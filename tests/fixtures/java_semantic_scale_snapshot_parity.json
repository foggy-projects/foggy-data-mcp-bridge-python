    "id" : "measure-having-sql",
    "type" : "sql",
    "model" : "FactSalesSemanticScaleQueryModel",
    "request" : {
      "columns" : [ "orderId", "sum(salesAmountYuan) as totalSalesAmountYuan" ],
      "having" : [ {
        "field" : "totalSalesAmountYuan",
